# Environment Configuration Example
# Copy this file to .env and run `npm run generate:secrets` to generate random secrets.
# NEVER commit the actual .env file or real secrets to git.

NODE_ENV=development
PORT=3000

# Databases
DATABASE_URL=postgresql://postgres:replace-me-postgres-password@localhost:5432/payora_ledger
AUTH_DATABASE_URL=postgresql://postgres:replace-me-postgres-password@localhost:5432/payora_auth
REDIS_URL=redis://localhost:6379

# Docker Compose Service Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me-postgres-password
POSTGRES_DB=payora_ledger
POSTGRES_PORT=5433
REDIS_PORT=6380

# Security Secrets (Must be at least 32 characters in length)
JWT_SECRET=replace-me-with-a-random-secret-key-at-least-32-chars
WEBHOOK_SECRET=replace-me-with-a-random-webhook-secret-at-least-32-chars
MERCHANT_QR_SECRET=replace-me-with-a-random-merchant-qr-secret-32chars

# Mailpit (Local development email inspector)
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
